{
  "entities": {
    "chats": {
      "title": "Chats",
      "description": "Active and archived customer chat conversations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Chat unique identifier" },
        "customerId": { "type": "string", "description": "Customer unique identifier" },
        "customer": { "type": "object", "description": "Customer metadata including phone and IP" },
        "department": { "type": "string", "description": "Assigned support department" },
        "status": { "type": "string", "description": "Chat status (open, closed, pending, unassigned)" },
        "priority": { "type": "string", "description": "Chat priority level" },
        "subject": { "type": "string", "description": "Subject line or initial inquiry" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "lastMessage": { "type": "string", "description": "Last message text snippet" },
        "lastMessageTime": { "type": "string", "description": "Relative or formatted time of last message" },
        "unreadCountCustomer": { "type": "number", "description": "Unread count for customer" },
        "unreadCountAgent": { "type": "number", "description": "Unread count for agent" }
      },
      "required": ["id", "customerId", "customer", "status", "updatedAt"]
    },
    "messages": {
      "title": "Messages",
      "description": "Chat messages between customers and agents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message unique identifier" },
        "chatId": { "type": "string", "description": "Associated chat ID" },
        "senderRole": { "type": "string", "description": "Role of sender (customer, agent, bot, system)" },
        "senderName": { "type": "string", "description": "Display name of sender" },
        "senderAvatar": { "type": "string", "description": "Avatar URL of sender" },
        "content": { "type": "string", "description": "Text content of the message" },
        "timestamp": { "type": "string", "description": "Timestamp string" },
        "readStatus": { "type": "string", "description": "Message status (sent, delivered, read)" }
      },
      "required": ["id", "chatId", "senderRole", "content"]
    },
    "settings": {
      "title": "Settings",
      "description": "App settings and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Settings key or ID" },
        "widgetConfig": { "type": "object", "description": "Widget visual and behavior configuration" },
        "quickReplies": { "type": "array", "description": "List of predefined quick reply templates" }
      },
      "required": ["id"]
    },
    "visitors": {
      "title": "Live Visitors",
      "description": "Real-time active visitors tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Visitor identifier" },
        "name": { "type": "string", "description": "Visitor name or display identifier" },
        "email": { "type": "string", "description": "Visitor email if provided" },
        "phone": { "type": "string", "description": "Visitor phone if provided" },
        "location": { "type": "string", "description": "Visitor location" },
        "currentPage": { "type": "string", "description": "Current active page path" },
        "timeOnPage": { "type": "string", "description": "Elapsed duration on page" },
        "device": { "type": "string", "description": "Device and browser information" },
        "deviceType": { "type": "string", "description": "phone, desktop, or tablet" },
        "ip": { "type": "string", "description": "Client IP address" },
        "referrer": { "type": "string", "description": "Traffic source or referrer URL" },
        "status": { "type": "string", "description": "browsing, in_chat, or invited" },
        "visitedAt": { "type": "string", "description": "Initial visit timestamp" },
        "lastActive": { "type": "number", "description": "Epoch timestamp of last activity heartbeat" },
        "pathHistory": { "type": "array", "description": "Full chronological navigation path and pages visited by user" },
        "chatInitiatedPage": { "type": "string", "description": "Exact page URL or title where chat was initiated" },
        "chatInitiatedAt": { "type": "string", "description": "Timestamp when chat was opened or initiated" }
      },
      "required": ["id", "location", "device", "status"]
    }
  }
}
